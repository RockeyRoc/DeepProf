{
  "name": "deepprof-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "DeepProf 桌宠前端 —— Electron + React（MVP-3 第一个模块）",
  "author": "张钧翔",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "cn.edu.xtu.deepprof.desktop",
    "productName": "DeepProf桌宠",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/tts",
        "to": "tools/tts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeepProf桌宠",
      "artifactName": "DeepProf桌宠-安装版-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DeepProf桌宠-免安装版-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
