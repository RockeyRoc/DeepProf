{
  "contract_version": "1.5.0",
  "_source_of_truth": "shared/contracts 的 v0.5 内容迁移到 packages/contracts；与 runtime/core/events.py 的 EventType 保持一致（守卫见 tests/test_contract_consistency.py）。",
  "envelope": {
    "event_id": "string, 事件唯一标识；重复 event_id 视为幂等重放",
    "session_id": "string",
    "trace_id": "string, 同一轮教学/工具链路的关联标识",
    "sequence": "integer, 同一 session 内单调递增；SSE 重连按此补发",
    "type": "string, 见 events",
    "payload": "object, 事件载荷；pedagogy.* 不得含学生正文",
    "source": "string, 产生该事件的组件（runtime | api | provider | tool | library | gateway）",
    "timestamp": "string, ISO-8601 UTC",
    "client_id": "string | null, 可选；发起命令的前端标识",
    "surface": "string | null, 可选；cli",
    "audience": "string | null, 可选；事件定向投递用"
  },
  "events": {
    "session.started": { "payload": { "title": "string", "learner_id": "string", "session_mode": "chat | study", "experiment_group": "A | B | C | null", "course_id": "string" } },
    "session.resumed": { "payload": { "from_sequence": "integer" } },
    "session.compacted": { "payload": { "before": "integer", "after": "integer" } },
    "session.ended": { "payload": { "reason": "string" } },
    "agent.started": { "payload": { "request_id": "string" } },
    "agent.turn.started": { "payload": { "turn": "integer", "session_mode": "chat | study", "turn_mode": "chat | study", "routing_reason": "string", "routing_version": "string" } },
    "agent.turn.completed": { "payload": { "turn": "integer", "status": "string" } },
    "agent.failed": { "payload": { "error": { "code": "string", "message": "string", "details": "object" } } },
    "model.requested": { "payload": { "role": "string", "provider_profile": "string", "model": "string" } },
    "model.stream.delta": { "payload": { "text": "string" } },
    "model.completed": { "payload": { "usage": "object", "model": "string" } },
    "model.failed": { "payload": { "error": { "code": "string", "message": "string", "details": "object" } } },
    "tool.requested": { "payload": { "tool": "string", "arguments": "object" } },
    "tool.approved": { "payload": { "tool": "string", "approved_by": "string" } },
    "tool.started": { "payload": { "tool": "string" } },
    "tool.completed": { "payload": { "tool": "string", "result": "object" } },
    "tool.failed": { "payload": { "tool": "string", "error": { "code": "string", "message": "string" } } },
    "memory.read": { "payload": { "scope": "string", "count": "integer" } },
    "memory.write": { "payload": { "scope": "string", "count": "integer" } },
    "library.imported": { "payload": { "resource_id": "string", "source_type": "string", "hash": "string", "duplicate": "boolean" } },
    "library.indexed": { "payload": { "resource_id": "string", "chunks": "integer" } },
    "pedagogy.node.entered": { "payload": { "node": "string" } },
    "pedagogy.decision": {
      "payload": {
        "node": "string",
        "action": "string",
        "reason": "string",
        "evidence_sufficient": "boolean",
        "evidence_count": "integer",
        "attempt_count": "integer",
        "wrong_streak": "integer",
        "hint_level": "integer | null",
        "turn_count": "integer",
        "max_turns": "integer",
        "capability": "string",
        "capability_status": "string",
        "answer_leaked": "boolean, 仅 hint/test 声明",
        "content_length": "integer, 只记长度，不记学生正文"
      }
    },
    "pedagogy.node.exited": { "payload": { "node": "string", "next": "string | null" } },
    "teaching.decision": { "payload": { "group": "A | B | C", "action": "string", "policy_version": "string", "reason_codes": "string[]", "evidence_refs": "locator[]" } },
    "teaching.turn.completed": { "payload": { "group": "A | B | C", "action": "string", "policy_version": "string", "evidence_refs": "locator[]" } },
    "conversation.turn.completed": { "payload": { "session_mode": "chat | study", "turn_mode": "chat", "routing_reason": "string", "routing_version": "string" } },
    "quiz.issued": { "payload": { "item_id": "string", "concept_ids": "string[]", "difficulty": "integer", "question_type": "string" } },
    "quiz.scored": { "payload": { "item_id": "string", "scored_concept_id": "string", "correct": "boolean", "grading_source": "string", "confidence": "number", "bkt_status": "string" } },
    "quiz.review_pending": { "payload": { "item_id": "string", "scored_concept_id": "string", "correct": "null", "grading_source": "string", "confidence": "number", "bkt_status": "string" } },
    "pedagogy.attempt": { "payload": { "attempt_id": "string", "course_id": "string", "item_id": "string", "scored_concept_id": "string", "concept_ids": "string[]", "correct": "boolean", "hint_count": "integer", "grading_source": "string", "confidence": "number", "predicted_correct": "number", "learner_estimate": "object | null" } },
    "pedagogy.attempt_skipped": { "payload": { "attempt_id": "string", "course_id": "string", "item_id": "string", "scored_concept_id": "string", "concept_ids": "string[]", "correct": "boolean | null", "eligible": "false", "skip_reason": "string" } },
    "document.converted": { "payload": { "status": "string", "source_sha256": "string", "page_count": "integer", "ocr_used": "boolean", "review_required": "boolean", "markdown_path": "string", "metadata_path": "string" } }
  },
  "_sse_frames": {
    "passthrough": [
      "session.started",
      "model.stream.delta",
      "pedagogy.decision",
      "teaching.decision",
      "teaching.turn.completed",
      "quiz.issued",
      "quiz.scored",
      "quiz.review_pending",
      "pedagogy.attempt",
      "pedagogy.attempt_skipped",
      "document.converted"
    ],
    "synthetic": [
      "pedagogy.result"
    ]
  },
  "_privacy": "教学决策事件仅含策略和定位引用，不得包含学生正文、教材全文或密钥。"
}
