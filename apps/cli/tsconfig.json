{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "../..",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../../apps/desktop/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../packages/client_sdk/**/*.ts"]
}
