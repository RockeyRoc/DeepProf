{
  "name": "@deepprof/desktop",
  "version": "0.6.1",
  "private": true,
  "description": "DeepProf Desktop 工作台（MVP-3）",
  "main": "./out/main/app.js",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && electron-vite dev",
    "build": "npm run prepare-assets && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "cn.edu.xtu.deepprof.desktop",
    "productName": "DeepProf",
    "files": ["out/**/*", "package.json"],
    "extraResources": [{"from": "../../api", "to": "runtime/api"}, {"from": "../../runtime", "to": "runtime/runtime"}]
  },
  "dependencies": {
    "@deepprof/client-sdk": "file:../../packages/client_sdk",
    "@deepprof/design-system": "file:../../packages/design_system",
    "@deepprof/pet": "file:../pet",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
