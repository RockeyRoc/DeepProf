# DeepProf 配置样例。所有值都有代码内默认值，无需全部填写。
# 约定：默认值必须与 config/settings.py 保持一致（由 tests/test_config_consistency.py 守卫）。

# 用户数据根：留空 = ~/.deepprof
DEEPPROF_HOME=

# 模型调用
DEEPPROF_LLM_MAX_TOKENS=4096
DEEPPROF_LLM_TIMEOUT_SECONDS=120
DEEPPROF_LLM_MAX_RETRIES=2
DEEPPROF_STREAM_INCLUDE_USAGE=true

# Provider 能力探测
DEEPPROF_PROBE_MAX_TOKENS=512

# API / Gateway
DEEPPROF_API_HOST=127.0.0.1
DEEPPROF_API_PORT=0

# 存储路径：留空 = 解析到 ~/.deepprof 下
DEEPPROF_SQLITE_PATH=
DEEPPROF_VECTOR_DB_PATH=
DEEPPROF_PLUGIN_DIR=
DEEPPROF_LIBRARY_DIR=
DEEPPROF_LIBRARY_CHUNK_SIZE=800
DEEPPROF_LIBRARY_CHUNK_OVERLAP=120
DEEPPROF_LIBRARY_MAX_IMPORT_BYTES=50000000
DEEPPROF_LIBRARY_CRAWL_DELAY_SECONDS=1
DEEPPROF_LIBRARY_ALLOWLIST=
DEEPPROF_LIBRARY_TOS_CONFIRMED_DOMAINS=

# 沙箱白名单（逗号分隔；~ 会展开）
DEEPPROF_SANDBOX_ALLOWLIST=~/.deepprof

# 截图默认关闭，仅显式开启
DEEPPROF_SCREENSHOT_ENABLED=false

DEEPPROF_LOG_LEVEL=INFO
