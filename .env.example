# ============================================================
# DeeepProf 环境变量模板（DESIGNv0.4）
# 使用前复制为 .env 并填入真实密钥：cp .env.example .env
# 切换 LLM 只需改 LLM_PROVIDER，业务代码无需改动
# ============================================================

# ---------- LLM Provider（deepseek | openai | qwen | fake） ----------
# fake = 确定性 FakeProvider，无密钥、不联网，用于开发与测试
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY={{your_deepseek_api_key}}
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# OpenAI
OPENAI_API_KEY={{your_openai_api_key}}
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# 本地/云端 Qwen（通过 OpenAI 兼容接口）
QWEN_API_KEY={{your_qwen_api_key}}
QWEN_BASE_URL=https://api.qnaigc.com/v1
QWEN_MODEL=qwen/qwen3.8-flash-next

# 对话参数
LLM_TEMPERATURE=0.7
# 推理模型（如 deepseek-flash）会先消耗 reasoning token，预算过小会导致正文为空（finish_reason=length）
LLM_MAX_TOKENS=4096
# 单次模型调用的连接/读空闲超时（秒）；SDK 默认 600s 会让挂起的流式请求拖 10 分钟才失败
LLM_TIMEOUT_SECONDS=120.0

# ---------- 记忆与存储（D-3：接口抽象 + 本地 SQLite） ----------
# 留空 = 用户数据目录默认位置：~/.deepprof/sessions/deepprof.db（vector_store 同理在 ~/.deepprof/memory）
# 可写相对路径（相对项目根，开发用）或绝对路径覆盖
SQLITE_PATH=
VECTOR_DB_PATH=
SQLITE_BUSY_TIMEOUT_MS=5000

# ---------- Runtime ----------
RUNTIME_SOURCE=deepprof.runtime
AGENT_MAX_TURNS=8            # 单轮模型—工具循环上限，防止无限调用
# 单次工具执行的超时上限（秒）：工具挂起（网络/磁盘 IO）会被中止并转结构化失败
TOOL_TIMEOUT_SECONDS=30.0
SESSION_COMPACT_KEEP=12      # 上下文压缩时保留最近 N 条消息
TRACE_ID_HEADER=x-trace-id   # API 透传 trace_id 的请求头

# ---------- Sandbox（D-5：目录白名单 + 审批） ----------
# 逗号分隔：相对路径相对项目根，~/ 开头相对用户主目录（~/.deepprof 是会话库/记忆所在）
SANDBOX_ALLOWED_ROOTS=data,media,docs,~/.deepprof
SANDBOX_ALLOW_NETWORK=false
SANDBOX_ALLOW_PROCESS=false

# ---------- Plugin（D-4：仅受信 Python 插件） ----------
# 留空 = ~/.deepprof/plugins（用户装的插件跟用户数据走）
PLUGIN_DIR=
PLUGIN_TRUSTED_ONLY=true
# 运维维护的信任清单（外部裁定）：清单外的插件一律拒绝安装。
# 注意：plugin.json 里的 trusted 由插件自己写，不作为依据；审批请用 PluginTrustStore.approve()。
PLUGIN_TRUST_STORE=plugins/trusted.json

# ---------- 宠物侧 ----------
AFFINITY_INIT=30